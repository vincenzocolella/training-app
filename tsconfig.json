{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting - Relaxed to allow smooth phone deployments */
    "strict": true,
    "noUnusedLocals": false,        // 👈 Changed to false so unused vars don't crash builds
    "noUnusedParameters": false,    // 👈 Changed to false
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true // 👈 Corrected typo name here
  },
  "include": ["src"]
}
